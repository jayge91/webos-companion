# Maintainer: Jonathon McGee <jayge91@gmail.com>
#
# Local-build PKGBUILD: run `makepkg` from a checkout with this file copied to
# the repo root (or `makepkg -p packaging/PKGBUILD` from the root). Before this
# can go to the AUR it needs a real `source=(...archive/v$pkgver.tar.gz)` and a
# matching git tag — see the Roadmap in README.md.
pkgname=webos-companion
pkgver=0.1.0
pkgrel=1
pkgdesc="Make an LG webOS TV follow the local display power state on KDE/Wayland"
arch=('any')
url="https://github.com/jayge91/webos-companion"
license=('MIT')
depends=('python' 'python-websockets' 'python-dbus-fast' 'python-yaml')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-asyncio' 'dbus')
source=()

build() {
    cd "$startdir"
    python -m build --wheel --no-isolation
}

check() {
    cd "$startdir"
    dbus-run-session -- python -m pytest -q
}

package() {
    cd "$startdir"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 systemd/webos-companion.service \
        "$pkgdir/usr/lib/systemd/user/webos-companion.service"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
