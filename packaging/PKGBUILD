# Maintainer: Jonathon McGee <jayge91@gmail.com>
#
# AUR submission checklist:
#   1. push the v$pkgver git tag (GitHub then serves the source tarball below)
#   2. run `updpkgsums` in this directory to fill in sha256sums
#   3. `makepkg --printsrcinfo > .SRCINFO`
#   4. push PKGBUILD + .SRCINFO to the AUR repo
pkgname=webos-companion
pkgver=0.1.0
pkgrel=1
pkgdesc="Make an LG webOS TV follow the local display power state on KDE/Wayland"
arch=('any')
url="https://github.com/jayge91/webos-companion"
license=('MIT')
depends=('python' 'python-websockets' 'python-dbus-fast' 'python-yaml')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-asyncio' 'dbus')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replace with `updpkgsums` once the tag is pushed

build() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    dbus-run-session -- python -m pytest -q
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 systemd/webos-companion.service \
        "$pkgdir/usr/lib/systemd/user/webos-companion.service"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
